# LOCAL DEVELOPMENT
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Google Identity Services Web OAuth client ID (public app identifier)
GOOGLE_CLIENT_ID=

# Exact browser origin allowed to sign in and call state-changing APIs
APP_ORIGIN=http://localhost:5173

# Optional: persistent SQLite file path (defaults to .local/adspark-auth.sqlite)
# AUTH_DB_PATH=.local/adspark-auth.sqlite

# Razorpay Standard Checkout for local development (secrets stay server-side)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=test

# CLOUDFLARE PRODUCTION
# Configure vars and secrets in Cloudflare; do not place production secrets in this file.
# AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# Set GOOGLE_CLIENT_ID, APP_ORIGIN, RAZORPAY_KEY_ID, and RAZORPAY_ENVIRONMENT
# as Worker vars. Set RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET as Worker secrets.
